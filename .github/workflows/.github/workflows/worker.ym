name: PROD Worker - CI/CD

on:
  push:
    branches: ["main"]
    paths:
      - "apps/worker/**"
      - "apps/api/**"
      - "packages/database/**"
      - "packages/shared/**"
      - "package.json"
      - "package-lock.json"
      - ".github/workflows/worker.yml"

jobs:
  # ----------------------------------------
  # Build and Push Worker Image to ECR
  # ----------------------------------------
  build-and-push:
    name: Build and Push Worker Image to ECR
    runs-on: ubuntu-latest
    environment: PROD
    permissions:
      contents: read
      id-token: write
    outputs:
      image_uri: ${{ steps.image.outputs.image_uri }}
      image_tag: ${{ steps.image.outputs.image_tag }}
      registry: ${{ steps.login-ecr.outputs.registry }}
    steps:
      - name: Checkout code
        uses: actions/checkout@v4.2.2

      - name: Configure AWS credentials using OIDC
        uses: aws-actions/configure-aws-credentials@v4.1.0
        with:
          role-to-assume: ${{ secrets.OIDC_ROLE_ARN }}
          aws-region: ${{ secrets.AWS_REGION }}
          role-session-name: aestelyx-prod-worker

      - name: Verify AWS Account
        env:
          EXPECTED_ACCOUNT_ID: ${{ secrets.AWS_ACCOUNT_ID }}
        run: |
          ACTUAL_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
          if [ "$ACTUAL_ACCOUNT_ID" != "$EXPECTED_ACCOUNT_ID" ]; then
            echo "ERROR: Unexpected AWS account."
            exit 1
          fi
          echo "AWS account verification passed."
      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Resolve deployment image
        id: image
        shell: bash
        env:
          ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
          ECR_REPOSITORY: ${{ secrets.WORKER_ECR_REPOSITORY }}
        run: |
          set -euo pipefail
          if [ -z "$ECR_REPOSITORY" ]; then
            echo "ERROR: WORKER_ECR_REPOSITORY secret is missing."
            exit 1
          fi
          echo "image_uri=${ECR_REGISTRY}/${ECR_REPOSITORY}" >> "$GITHUB_OUTPUT"
          echo "image_tag=${{ github.sha }}" >> "$GITHUB_OUTPUT"
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build and Push Worker Image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./apps/worker/Dockerfile
          push: true
          tags: |
            ${{ steps.image.outputs.image_uri }}:latest
            ${{ steps.image.outputs.image_uri }}:${{ github.sha }}
          cache-from: type=gha,scope=prod-worker
          cache-to: type=gha,mode=max,scope=prod-worker

  # ----------------------------------------
  # Deploy Worker to PROD EC2 via AWS SSM
  # ----------------------------------------
  deploy:
    name: Deploy Worker to PROD EC2 via AWS SSM
    runs-on: ubuntu-latest
    needs: build-and-push
    environment: PROD
    permissions:
      contents: read
      id-token: write
    concurrency:
      group: aestelyx-prod-worker
      cancel-in-progress: false
    steps:
      - name: Configure AWS credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4.1.0
        with:
          audience: sts.amazonaws.com
          role-to-assume: ${{ secrets.OIDC_ROLE_ARN }}
          aws-region: ${{ secrets.AWS_REGION }}
          role-session-name: aestelyx-prod-worker-deploy

      - name: Execute Deployment on EC2 via SSM Run Command
        run: |
          set -euo pipefail
          INSTANCE_ID="${{ secrets.PROD_EC2_INSTANCE_ID }}"
          AWS_REGION="${{ secrets.AWS_REGION }}"
          REPO_NAME=$(aws ssm get-parameter --name "/api/WORKER_ECR_REPOSITORY" --with-decryption --query "Parameter.Value" --output text 2>/dev/null || echo "${{ secrets.WORKER_ECR_REPOSITORY || 'prod-worker' }}")
          ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
          ECR_REGISTRY="${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
          ECR_REPO="${ECR_REGISTRY}/${REPO_NAME}"
          REMOTE_SCRIPT=$(cat << EOF | base64 -w 0
          set -e
          echo "=== 🚀 Starting PROD Worker Deployment ==="
          export PATH=\$PATH:/usr/local/bin:/usr/bin:/bin
          # 1. Shared Deployment Lock
          exec 9>/tmp/aestelyx-prod-deploy.lock
          if ! flock -w 1800 9; then
            echo "❌ ERROR: Timed out waiting for shared PROD deployment lock."
            exit 1
          fi
          # 2. Disk Space Cleanup Check
          AVAIL_KB=\$(df -k / | awk 'NR==2 {print \$4}')
          if [ "\$AVAIL_KB" -lt 3000000 ]; then
            sudo docker container prune -f || true
            sudo docker image prune -af || true
          fi
          # 3. ECR Login & Pull
          aws ecr get-login-password --region ${AWS_REGION} | sudo docker login --username AWS --password-stdin ${ECR_REGISTRY}
          
          echo "📥 Pulling AWS ECR Image: ${ECR_REPO}:latest"
          if ! sudo docker pull "${ECR_REPO}:latest"; then
            sudo docker builder prune -f || true
            sudo docker pull "${ECR_REPO}:latest"
          fi
          # 4. Production Network Verification
          sudo docker network inspect aestelyx-prod-net >/dev/null 2>&1 || sudo docker network create aestelyx-prod-net
          # 5. Fetch ALL SSM Parameters directly from SSM Parameter Store (/api/)
          mkdir -p /etc/aestelyx
          RAW_ENV="/tmp/worker_raw.env"
          FINAL_ENV="/etc/aestelyx/worker.env"
          echo "📦 Fetching parameters directly from SSM Parameter Store (/api/)..."
          aws ssm get-parameters-by-path \
            --path "/api/" \
            --recursive \
            --with-decryption \
            --region ${AWS_REGION} \
            --query "Parameters[*].[Name,Value]" \
            --output text | awk '{
              split(\$1, a, "/"); 
              param_name = a[length(a)]; 
              \$1=""; 
              sub(/^ /, ""); 
              print param_name "=" \$0
            }' > "\$RAW_ENV"
          # Extract or resolve default fallback values
          SIGNING_SECRET=\$(grep -E '^FILE_ACCESS_SIGNING_SECRET=' "\$RAW_ENV" | cut -d'=' -f2- || true)
          if [ -z "\$SIGNING_SECRET" ]; then
            SIGNING_SECRET="aestelyx_prod_file_signing_secret_key_2026"
          fi
          API_URL_VAL=\$(grep -E '^API_URL=' "\$RAW_ENV" | cut -d'=' -f2- || true)
          if [ -z "\$API_URL_VAL" ]; then
            API_URL_VAL=\$(grep -E '^NEXT_PUBLIC_API_URL=' "\$RAW_ENV" | cut -d'=' -f2- || echo 'https://api.aestelyx.com')
          fi
          {
            cat "\$RAW_ENV"
            echo ""
            echo "# --- System Mandatory Worker Overrides ---"
            echo "API_URL=\$API_URL_VAL"
            echo "FILE_ACCESS_SIGNING_SECRET=\$SIGNING_SECRET"
            echo "WORKER_ENABLED=true"
            echo "NODE_ENV=production"
            echo "PORT=4000"
            echo "AUTH_COOKIE_ENABLED=true"
            echo "AUTH_COOKIE_SECURE=true"
            echo "BREAK_GLASS_PATIENT_MINUTES=15"
            echo "FILE_ACCESS_URL_TTL_SECONDS=300"
            echo "FILE_STORAGE_REQUIRE_S3=true"
            echo "EMAIL_ENABLED=true"
            echo "EMAIL_PROVIDER=aws_ses"
            echo "EMAIL_FROM=Aestelyx <no-reply@aestelyx.com>"
            echo "EMAIL_REPLY_TO=no-reply@aestelyx.com"
          } > "\$FINAL_ENV"
          # Strip outer quotes for Prisma DATABASE_URL compatibility
          sed -i 's/^DATABASE_URL="\(.*\)"$/DATABASE_URL=\1/' "\$FINAL_ENV"
          # 6. Restart Worker Container
          echo "🛑 Stopping existing worker container..."
          sudo docker stop aestelyx-worker || true
          sudo docker rm aestelyx-worker || true
          echo "🚀 Starting new aestelyx-worker container..."
          sudo docker run -d \
            --name aestelyx-worker \
            --network aestelyx-prod-net \
            --add-host=postgres:172.17.0.1 \
            --restart always \
            --env-file "\$FINAL_ENV" \
            -e PORT=4000 \
            -e NODE_ENV=production \
            -e WORKER_ENABLED=true \
            "${ECR_REPO}:latest"
          # 7. Verification Check
          sleep 10
          IS_RUNNING=\$(sudo docker inspect --format='{{.State.Running}}' aestelyx-worker 2>/dev/null || echo "false")
          if [ "\$IS_RUNNING" != "true" ]; then
            echo "❌ Worker Container Crashed! Printing Logs:"
            sudo docker logs --tail 100 aestelyx-worker || true
            exit 1
          fi
          sudo docker image prune -f || true
          echo "=== ✅ PROD Worker Deployment Complete Successfully ==="
          EOF
          )
          COMMAND_ID=$(aws ssm send-command \
            --instance-ids "$INSTANCE_ID" \
            --document-name "AWS-RunShellScript" \
            --parameters "commands=[\"echo $REMOTE_SCRIPT | base64 -d | bash\"]" \
            --query "Command.CommandId" \
            --output text)
          echo "Waiting for SSM Command $COMMAND_ID..."
          if ! aws ssm wait command-executed --command-id "$COMMAND_ID" --instance-id "$INSTANCE_ID"; then
            echo "::error::SSM Deployment Failed! Execution Log:"
            aws ssm get-command-invocation \
              --command-id "$COMMAND_ID" \
              --instance-id "$INSTANCE_ID" \
              --query "{Status: Status, StandardOutputContent: StandardOutputContent, StandardErrorContent: StandardErrorContent}" \
              --output json
            exit 1
          fi
